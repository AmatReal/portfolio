---
import { projects } from '../data/projects';
const projectsJson = JSON.stringify(projects);
---

<dialog
  id="project-modal"
  class="project-modal"
  aria-label="Project preview"
  aria-modal="true"
>
  <div class="modal-header">
    <div>
      <div class="modal-eyebrow" data-modal-eyebrow></div>
      <div class="modal-title" data-modal-title></div>
    </div>
    <button
      type="button"
      data-modal-close
      aria-label="Cerrar"
      class="modal-close"
    >&times;</button>
  </div>

  <div class="modal-grid">
    <div class="modal-main">
      <video data-main-video muted loop playsinline controls hidden></video>
      <img data-main-image alt="" hidden draggable="false" />
      <button
        type="button"
        class="modal-zoom"
        data-modal-zoom
        aria-label="Ampliar vista"
      >&#x2922;</button>
    </div>

    <div class="modal-info">
      <div class="modal-desc">
        <h4>Description</h4>
        <div data-modal-description></div>
      </div>
      <div class="modal-divider"></div>
      <div>
        <h4>Technologies</h4>
        <p class="modal-tech" data-modal-technologies></p>
      </div>
    </div>

    <div class="modal-carousel">
      <button
        type="button"
        class="carousel-arrow"
        data-dir="-1"
        aria-label="Anterior"
      >&lsaquo;</button>
      <div class="carousel-track" data-carousel-track></div>
      <button
        type="button"
        class="carousel-arrow"
        data-dir="1"
        aria-label="Siguiente"
      >&rsaquo;</button>
    </div>
  </div>

  <div class="modal-footer">
    <button type="button" data-modal-close class="btn-secondary">Cerrar</button>
    <a
      href="#"
      target="_blank"
      rel="noopener"
      class="btn-primary"
      data-modal-breakdown
    >
      View breakdown <i class="uil uil-arrow-up-right"></i>
    </a>
  </div>
</dialog>

<dialog id="media-lightbox" class="media-lightbox" aria-label="Vista ampliada">
  <video id="lightbox-video" controls autoplay muted loop playsinline hidden></video>
  <img id="lightbox-image" alt="" hidden draggable="false" />
</dialog>

<script type="application/json" id="projects-data" set:html={projectsJson}></script>

<script>
  const projects = JSON.parse(document.getElementById('projects-data').textContent);
  const dialog = document.getElementById('project-modal');
  if (dialog) {
    const eyebrow = dialog.querySelector('[data-modal-eyebrow]');
    const title = dialog.querySelector('[data-modal-title]');
    const description = dialog.querySelector('[data-modal-description]');
    const technologies = dialog.querySelector('[data-modal-technologies]');
    const breakdown = dialog.querySelector('[data-modal-breakdown]');
    const mainVideo = dialog.querySelector('[data-main-video]');
    const mainImage = dialog.querySelector('[data-main-image]');
    const track = dialog.querySelector('[data-carousel-track]');
    const arrows = dialog.querySelectorAll('.carousel-arrow');
    const zoomButton = dialog.querySelector('[data-modal-zoom]');
    const lightbox = document.getElementById('media-lightbox');
    const lightboxVideo = document.getElementById('lightbox-video');
    const lightboxImage = document.getElementById('lightbox-image');
    let currentItem = null;

    function template(tag, className, attrs = {}) {
      const el = document.createElement(tag);
      if (className) el.className = className;
      Object.entries(attrs).forEach(([key, value]) => {
        if (value != null) el.setAttribute(key, value);
      });
      return el;
    }

    function buildCarousel(items) {
      track.innerHTML = '';
      items.forEach((item, index) => {
        const btn = template('button', index === 0 ? 'carousel-item is-active' : 'carousel-item', {
          type: 'button',
          'data-type': item.type,
          'data-src': item.src,
          'aria-label': item.alt,
        });
        if (item.type === 'video') {
          const video = template('video', '', { src: item.src, muted: '', playsinline: '', preload: 'metadata' });
          const play = template('span', 'carousel-play');
          const playInner = template('span', '', {});
          playInner.textContent = '\u25B6';
          play.appendChild(playInner);
          btn.appendChild(video);
          btn.appendChild(play);
        } else {
          const img = template('img', '', { src: item.src, alt: item.alt, loading: 'lazy', decoding: 'async' });
          btn.appendChild(img);
        }
        track.appendChild(btn);
      });
    }

    function showInMain(item) {
      currentItem = item;
      if (item.type === 'video') {
        mainImage.hidden = true;
        mainVideo.hidden = false;
        if (mainVideo.getAttribute('src') !== item.src) mainVideo.src = item.src;
        mainVideo.play().catch(() => {});
      } else {
        mainVideo.pause();
        mainVideo.hidden = true;
        mainImage.src = item.src;
        mainImage.alt = item.alt;
        mainImage.hidden = false;
      }

      track.querySelectorAll('.carousel-item').forEach((el) => {
        const isActive = el.dataset.src === item.src && el.dataset.type === item.type;
        el.classList.toggle('is-active', isActive);
      });
    }

    function populate(project) {
      eyebrow.textContent = project.eyebrow;
      title.textContent = project.title;
      description.innerHTML = '';
      project.description.forEach((paragraph) => {
        const p = document.createElement('p');
        p.textContent = paragraph;
        description.appendChild(p);
      });
      technologies.textContent = project.technologies;
      breakdown.href = project.breakdownUrl;
      dialog.setAttribute('aria-label', project.title);

      buildCarousel(project.items);
      showInMain(project.items[0]);
      updateArrows();
    }

    document.addEventListener('click', (event) => {
      const trigger = event.target instanceof Element ? event.target.closest('[data-modal-open]') : null;
      if (trigger) {
        event.preventDefault();
        const project = projects[trigger.dataset.project];
        if (project) {
          populate(project);
          dialog.showModal();
        }
      }
    });

    dialog.querySelectorAll('[data-modal-close]').forEach((btn) => {
      btn.addEventListener('click', () => dialog.close());
    });

    dialog.addEventListener('click', (event) => {
      const rect = dialog.getBoundingClientRect();
      const outside =
        event.clientX < rect.left ||
        event.clientX > rect.right ||
        event.clientY < rect.top ||
        event.clientY > rect.bottom;
      if (outside) dialog.close();
    });

    track.addEventListener('click', (event) => {
      const item = event.target instanceof Element ? event.target.closest('.carousel-item') : null;
      if (!item) return;
      showInMain({ type: item.dataset.type, src: item.dataset.src, alt: item.dataset.alt ?? '' });
    });

    function openLightbox() {
      if (!lightbox || !currentItem) return;
      if (currentItem.type === 'video') {
        lightboxImage.hidden = true;
        lightboxVideo.hidden = false;
        lightboxVideo.src = currentItem.src;
      } else {
        lightboxVideo.pause();
        lightboxVideo.hidden = true;
        lightboxVideo.removeAttribute('src');
        lightboxImage.src = currentItem.src;
        lightboxImage.alt = currentItem.alt;
        lightboxImage.hidden = false;
      }
      lightbox.setAttribute('aria-label', currentItem.alt || 'Vista ampliada');
      lightbox.showModal();
    }

    zoomButton.addEventListener('click', openLightbox);
    mainImage.addEventListener('click', openLightbox);

    if (lightbox) {
      lightboxImage.addEventListener('click', () => lightbox.close());
      lightbox.addEventListener('click', (event) => {
        if (event.target === lightbox) lightbox.close();
      });
      lightbox.addEventListener('close', () => {
        lightboxVideo.pause();
        lightboxVideo.removeAttribute('src');
      });
    }

    dialog.addEventListener('close', () => {
      if (lightbox && lightbox.open) lightbox.close();
    });

    function updateArrows() {
      if (!track) return;
      const max = track.scrollWidth - track.clientWidth - 2;
      arrows.forEach((btn) => {
        const dir = Number(btn.dataset.dir);
        btn.disabled = dir < 0 ? track.scrollLeft <= 2 : track.scrollLeft >= max;
      });
    }

    arrows.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!track) return;
        const dir = Number(btn.dataset.dir);
        track.scrollBy({ left: dir * track.clientWidth * 0.85, behavior: 'smooth' });
      });
    });

    track.addEventListener('scroll', updateArrows, { passive: true });
    window.addEventListener('resize', updateArrows);
    window.addEventListener('load', updateArrows);
    setTimeout(updateArrows, 300);
  }
</script>