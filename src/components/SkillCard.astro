---
interface Props {
  name: string;
  icon?: string;
  iconBg?: string;
  iconClass?: string;
  faIcon?: string;
  logo?: string;
  badge?: string;
  badgeClass?: string;
  subtitle?: string;
}

const { name, icon, iconBg, iconClass, faIcon, logo, badge, badgeClass, subtitle } = Astro.props;
---

<div class="skill">
  {
    logo ? (
      <div class="skill-icon skill-icon--logo">
        <img src={logo} alt="" loading="lazy" decoding="async" draggable="false" />
      </div>
    ) : (
      iconBg && (
        <div class="skill-icon" style={`background:${iconBg}`}>
          {faIcon ? <i class={faIcon}></i> : iconClass ? <i class={`uil ${iconClass}`}></i> : icon}
        </div>
      )
    )
  }
  <h3>{name}</h3>
  {
    badge ? (
      <p class={badgeClass}>{badge}</p>
    ) : (
      <p class="skill-subtitle">{subtitle}</p>
    )
  }
</div>