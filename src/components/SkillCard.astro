---
interface Props {
  name: string;
  icon?: string;
  iconBg?: string;
  iconClass?: string;
  badge?: string;
  badgeClass?: string;
  subtitle?: string;
}

const { name, icon, iconBg, iconClass, badge, badgeClass, subtitle } = Astro.props;
---

<div class="skill">
  {
    iconBg && (
      <div class="skill-icon" style={`background:${iconBg}`}>
        {iconClass ? <i class={`uil ${iconClass}`}></i> : icon}
      </div>
    )
  }
  <h3>{name}</h3>
  {
    badge ? (
      <p class={badgeClass}>{badge}</p>
    ) : (
      <p class="skill-subtitle">{subtitle}</p>
    )
  }
</div>