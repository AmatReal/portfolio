---
interface Props {
  eyebrow: string;
  heading: string;
  description: string;
  variant: 'dragon' | 'ant' | 'bear';
  image?: string;
  emoji?: string;
  badgeIcon: string;
  captionTitle: string;
  captionSub?: string;
  cta?: { label: string; href: string };
  reverse?: boolean;
  project?: string;
}

const {
  eyebrow,
  heading,
  description,
  variant,
  image,
  emoji,
  badgeIcon,
  captionTitle,
  captionSub,
  cta,
  reverse = false,
  project,
} = Astro.props;
---

<div class:list={['project-row', { reverse }]}>
  <button
    type="button"
    class="project-media"
    data-modal-open
    data-project={project}
    aria-haspopup="dialog"
    aria-controls="project-modal"
    aria-label={`Abrir vista previa ${heading}`}
  >
    <div class:list={['ph-render', variant]}>
      {image ? (
        <img
          src={image}
          alt={heading}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      ) : (
        <span class="creature" aria-hidden="true">{emoji}</span>
      )}
      <div class="ph-caption">
        <div class="ph-badge"><i class={`uil ${badgeIcon}`}></i></div>
        <div>
          <strong>{captionTitle}</strong>
          {captionSub && <span>{captionSub}</span>}
        </div>
      </div>
    </div>
  </button>

  <div class="project-text">
    <div class="eyebrow">{eyebrow}</div>
    <h3>{heading}</h3>
    <p>{description}</p>
    {
      cta && (
        <a href={cta.href} target="_blank" rel="noopener" class="project-btn">
          {cta.label} <i class="uil uil-arrow-up-right"></i>
        </a>
      )
    }
  </div>
</div>