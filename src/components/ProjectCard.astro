---
interface Tag {
  label: string;
  icon?: string;
}

interface Props {
  glyph: string;
  gradient: string;
  title: string;
  description: string;
  tags: Tag[];
  ariaLabel: string;
  image?: string;
  project?: string;
}

const { glyph, gradient, title, description, tags, ariaLabel, image, project } = Astro.props;
---

<article class="card">
  <button
    type="button"
    class="card-media"
    data-modal-open
    data-project={project}
    aria-haspopup="dialog"
    aria-controls="project-modal"
    aria-label={ariaLabel}
    style={`background:${gradient}`}
  >
    {
      image ? (
        <img src={image} alt={title} loading="lazy" decoding="async" />
      ) : (
        <span>{glyph} {title}</span>
      )
    }
    <span class="card-media-tag"><i class="uil uil-eye"></i> Click for more</span>
  </button>
  <div class="card-body">
    <h3><a href="#">{title}</a></h3>
    <p>{description}</p>
    <div class="tags">
      {tags.map((tag) => (
        <span class="tag">
          {tag.icon && <i class={`uil ${tag.icon}`}></i>}
          {tag.label}
        </span>
      ))}
    </div>
  </div>
</article>