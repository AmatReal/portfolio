---
interface Props {
  variant?: 'home' | 'projects';
}

const { variant = 'home' } = Astro.props;
---

<header class="navbar" id="navbar">
  <div class="logo"><img class="logo-img" src="/assets/images/Logos/Amat3d_Logo.jpeg" alt="AMAT.3D" /> AMAT.3D</div>
  <nav>
    {
      variant === 'home' ? (
        <>
          <a href="#about">About me</a>
          <a href="/projects/">Projects</a>
          <a href="#software">Software</a>
        </>
      ) : (
        <>
          <a href="/">Home</a>
          <a href="/projects/" class="active" aria-current="page">Projects</a>
          <a href="/#software">Software</a>
        </>
      )
    }
  </nav>
</header>