---
interface Props {
  variant?: 'home' | 'projects';
}

const { variant = 'home' } = Astro.props;
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="navbar" id="navbar">
  <div class="logo"><img class="logo-img" src={`${BASE}/assets/images/Logos/Amat3d_Logo.jpeg`} alt="AMAT.3D" draggable="false" /> <span class="logo-text">AMAT.3D</span></div>
  <nav>
    {
      variant === 'home' ? (
        <>
          <a href="#about">Home</a>
          <a href={`${BASE}/projects/`}>Projects</a>
          <a href="#software">Software</a>
        </>
      ) : (
        <>
          <a href={`${BASE}/`}>Home</a>
          <a href={`${BASE}/projects/`} class="active" aria-current="page">Projects</a>
          <a href={`${BASE}/#software`}>Software</a>
        </>
      )
    }
  </nav>
</header>
