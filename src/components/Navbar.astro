---
interface Props {
  variant?: 'home' | 'projects';
}

const { variant = 'home' } = Astro.props;
---

<header class="navbar" id="navbar">
  <div class="logo"><span class="logo-mark">MZ</span> Mateo Zamora</div>
  <nav>
    {
      variant === 'home' ? (
        <>
          <a href="#about">About me</a>
          <a href="/projects/" target="_blank" rel="noopener">Projects</a>
          <a href="#software">Software</a>
        </>
      ) : (
        <>
          <a href="/">Home</a>
          <a href="/projects/" class="active" aria-current="page">Projects</a>
        </>
      )
    }
  </nav>
</header>