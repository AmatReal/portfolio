---
import Layout from '../components/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import SkillCard from '../components/SkillCard.astro';
import ProjectModal from '../components/ProjectModal.astro';
import { projects } from '../data/projects';

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');

const featured = [
  {
    eyebrow: 'Featured — Cinematic & Rig',
    heading: 'GAUNTLET OF GODS',
    description:
      'Stylized cinematic for the Gauntlet Of Gods card battler. Rigged the rabbit hero and built the low-poly world with geometry-node driven eyes, trading card renders and orchestrated camera moves.',
    variant: 'dragon',
    image: projects['gauntlet-of-gods'].preview,
    project: 'gauntlet-of-gods',
    badgeIcon: 'uil-film',
    captionTitle: 'Press for more information',
  },
  {
    eyebrow: 'Featured — Beat-driven Animation',
    heading: 'DREAM SEQUENCE',
    description:
      '4-second 120 BPM beat-driven animation for community challenge, built and animated entirely in Blender.',
    variant: 'dragon',
    image: projects['dream-sequence'].preview,
    project: 'dream-sequence',
    badgeIcon: 'uil-moon',
    captionTitle: 'Press for more information',
    reverse: true,
  },
  {
    eyebrow: 'Featured — Creature Rig',
    heading: 'DRAGON RIG & ANIMATION',
    description:
      'Adapted and optimized a high-resolution dragon sculpt into a fully animatable rig. Developed IK/FK systems using drivers and constraints, along with secondary physics-based bones to enhance realism and motion detail.',
    variant: 'dragon',
    image: projects.dragon.preview,
    project: 'dragon',
    badgeIcon: 'uil-cube',
    captionTitle: 'Press for more information',
  },
];

const softwareSkills = [
  { name: 'Blender', logo: `${BASE}/assets/images/Logos/Blender_Logo.png`, badge: 'Professional', badgeClass: 'lvl-pro' },
  { name: 'Maya', logo: `${BASE}/assets/images/Logos/Maya_Logo.png`, badge: 'Advanced', badgeClass: 'lvl-adv' },
  { name: 'ZBrush', logo: `${BASE}/assets/images/Logos/Zbrush_Logo.png`, badge: 'Intermediate', badgeClass: 'lvl-int' },
  { name: '3D Max', logo: `${BASE}/assets/images/Logos/3DMax_Logo.svg`, badge: 'Intermediate', badgeClass: 'lvl-int' },
  { name: 'Unreal Engine', logo: `${BASE}/assets/images/Logos/Unreal_Logo.png`, badge: 'Advanced', badgeClass: 'lvl-adv' },
  { name: 'Premiere Pro', logo: `${BASE}/assets/images/Logos/Adobe_Premiere_Pro_Logo.png`, badge: 'Professional', badgeClass: 'lvl-pro' },
  { name: 'After Effects', logo: `${BASE}/assets/images/Logos/Adobe_After_Effects_Logo.png`, badge: 'Advanced', badgeClass: 'lvl-adv' },
];

const proceduralSkills = [
  { name: 'Geometry Nodes', logo: `${BASE}/assets/images/Logos/blender_icon_geometry_nodes.svg`, subtitle: 'Procedural modeling' },
  { name: 'Procedural Animation', faIcon: 'fa-solid fa-wand-magic-sparkles', iconBg: '#9333ea', subtitle: 'Systems & motion' },
];

const riggingSkills = [
  { name: 'Complex Constraints', logo: `${BASE}/assets/images/Logos/blender_icon_constraint.svg`, subtitle: 'Rig behavior' },
  { name: 'Custom Drivers', logo: `${BASE}/assets/images/Logos/blender_icon_driver.svg`, subtitle: 'Control logic' },
  { name: 'Node-Based Logic', logo: `${BASE}/assets/images/Logos/blender_icon_nodetree.svg`, subtitle: 'Modular setups' },
];
---

<Layout
  title="Mateo Zamora Grajeda — Rigging Artist & Animator"
  description="Portfolio of Mateo Zamora, rigging artist and animator specialized in characters, creatures and objects for videogames, videos and marketing."
>
  <Navbar variant="home" />

  <section id="about" class="hero">
    <div class="hero-video">
      <div class="video-wrapper">
        <video
          class="hero-media"
          src={`${BASE}/assets/videos/Gauntlet Of Gods/Gauntlet Of Gods.mp4`}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label="Gauntlet Of Gods video preview"
        ></video>
        <div class="video-overlay">
          <h3>Gauntlet Of Gods</h3>
        </div>
      </div>
    </div>

    <div class="info">
      <div class="foto" aria-label="Foto de perfil">
        <img src={`${BASE}/assets/images/Logos/Amat3d_Logo.jpeg`} alt="Mateo Zamora" decoding="async" fetchpriority="high" />
      </div>
      <h1>AMAT.3D</h1>
      <h2>Rigging artist &amp; Animator</h2>
      <p>Mateo Zamora, specialized in rigging and animation for characters, creatures or objects for videogames, videos and marketing.</p>
      <div class="contact-lines">
        <p><i class="uil uil-envelope"></i> originalamat@gmail.com</p>
      </div>
      <div class="social">
        <a href="https://www.instagram.com/amat.3d/?hl=en" target="_blank" rel="noopener" aria-label="Instagram" class="social-icon"><img src={`${BASE}/assets/images/Logos/Instagram_Logo.png`} alt="Instagram" loading="lazy" decoding="async" /></a>
        <a href="https://mx.linkedin.com/in/mateo-zamora-474546261" target="_blank" rel="noopener" aria-label="LinkedIn" class="social-icon"><img src={`${BASE}/assets/images/Logos/LinkedIn_logo.png`} alt="LinkedIn" loading="lazy" decoding="async" /></a>
        <a href="https://x.com/TheAmat3D" target="_blank" rel="noopener" aria-label="Twitter / X" class="social-icon"><img src={`${BASE}/assets/images/Logos/X_Logo.png`} alt="Twitter / X" loading="lazy" decoding="async" /></a>
      </div>
    </div>
  </section>

  <section class="featured-projects">
    {featured.map((project) => <FeaturedProject {...project} />)}
  </section>

  <div class="view-more-wrapper">
    <a href={`${BASE}/projects/`} class="btn-view-more">View More</a>
  </div>

  <section id="software" class="skills">
    <h2 class="title">TECHNICAL KNOWLEDGE</h2>
    <p class="title-sub">TOOLS &amp; SPECIALTIES</p>

    <div class="skills-group-container">
      <h3 class="skills-group-title">SOFTWARE</h3>
      <div class="skills-grid">
        {softwareSkills.map((skill) => <SkillCard {...skill} />)}
      </div>
    </div>

    <div class="skills-group-container">
      <h3 class="skills-group-title">PROCEDURAL SYSTEMS</h3>
      <div class="skills-grid">
        {proceduralSkills.map((skill) => <SkillCard {...skill} />)}
      </div>
    </div>

    <div class="skills-group-container">
      <h3 class="skills-group-title">RIGGING &amp; LOGIC</h3>
      <div class="skills-grid">
        {riggingSkills.map((skill) => <SkillCard {...skill} />)}
      </div>
    </div>
  </section>

  <Footer />

  <ProjectModal />
</Layout>

<script>
  // Navbar hide on scroll
  let lastY = window.scrollY;
  const navbar = document.getElementById('navbar');
  window.addEventListener(
    'scroll',
    () => {
      const y = window.scrollY;
      if (navbar) {
        if (y > lastY && y > 120) navbar.classList.add('nav-hidden');
        else navbar.classList.remove('nav-hidden');
      }
      lastY = y;
    },
    { passive: true }
  );

  // Hero video overlay toggle on mobile (≤768px)
  const videoWrapper = document.querySelector('.hero .video-wrapper');
  if (videoWrapper) {
    videoWrapper.addEventListener('click', () => {
      if (window.innerWidth <= 768) {
        videoWrapper.classList.toggle('is-open');
      }
    });
  }

  // Scroll-spy: highlight active nav link
  const navLinks = document.querySelectorAll('.navbar nav a[href^="#"]');
  const sections = Array.from(navLinks)
    .map((link) => document.querySelector(link.getAttribute('href')))
    .filter(Boolean);

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((link) => link.classList.remove('active'));
          const active = document.querySelector(
            `.navbar nav a[href="#${entry.target.id}"]`
          );
          if (active) active.classList.add('active');
        }
      });
    },
    { rootMargin: '-40% 0px -50% 0px', threshold: 0 }
  );

  sections.forEach((section) => observer.observe(section));
</script>