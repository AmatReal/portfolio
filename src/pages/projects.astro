---
import Layout from '../components/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectModal from '../components/ProjectModal.astro';
import { projectGroups, projects } from '../data/projects';

const softwareTagList = ['Blender', 'Maya', 'Unreal engine', 'Unity'];
const specialtyTagList = ['Animation', 'Geometry Nodes', 'Blendshapes', 'Custom UI', 'Deformation', 'Physics', 'Game-Ready', 'WIP'];

const featuredProductions = [
  {
    glyph: '🎬',
    gradient: 'linear-gradient(135deg,#1a0f1e,#3a1440)',
    title: 'Gauntlet Of Gods - Pwnisher Challenge',
    description:
      'Stylized cinematic for the Gauntlet Of Gods card battler, with a rigged rabbit hero, geometry-node eyes and orchestrated camera moves.',
    tags: [{ label: 'Blender' }, { label: 'Geometry Nodes' }],
    ariaLabel: 'Abrir Gauntlet Of Gods',
    image: projects['gauntlet-of-gods'].preview,
    project: 'gauntlet-of-gods',
  },
  {
    glyph: '🌙',
    gradient: 'linear-gradient(135deg,#0a0a23,#1a1d4a)',
    title: 'Dream Sequence — Pwnisher Challenge',
    description:
      '4-second 120 BPM beat-driven animation for community challenge, built and animated entirely in Blender.',
    tags: [{ label: 'Blender' }],
    ariaLabel: 'Abrir Dream Sequence',
    image: projects['dream-sequence'].preview,
    project: 'dream-sequence',
  },
];
---

<Layout
  title="Mateo Zamora — Projects"
  description="Comprehensive library of rigging and animation work by Mateo Zamora, organized for efficient exploration."
>
  <Navbar variant="projects" />

  <main class="wrap">
    <div class="header">
      <h1>Project Archives</h1>
      <p>A comprehensive library of my rigging and animation work, organized for efficient exploration.</p>
      <p class="hint">Press on any project's card to see more details.</p>
    </div>

    <section class="featured-productions" aria-labelledby="featured-productions-title">
      <header class="fp-head">
        <p class="eyebrow">Selected Work</p>
        <h2 id="featured-productions-title">Featured Productions</h2>
      </header>
      <div class="fp-grid">
        {featuredProductions.map((card) => <ProjectCard {...card} darkTags />)}
      </div>
    </section>

    <div class="tag-filters" style="margin-bottom: 8px;">
      <div class="tf-row" role="group" aria-label="Filter by category">
        <span class="tf-row-label">Category:</span>
        <label class="cat-wrap">
          <select class="cat-sel" id="catFilter">
            <option value="all">All Categories</option>
            {projectGroups.map((group) => <option value={group.category}>{group.category}</option>)}
          </select>
          <i class="uil uil-angle-down"></i>
        </label>
      </div>
      <p class="tf-label" id="tag-filter-label">Filter by technology &amp; feature:</p>
      <div class="tf-row" role="group" aria-labelledby="tag-filter-label">
        <span class="tf-row-label">Software:</span>
        {softwareTagList.map((tag) => (
          <button type="button" class="tf-chip" data-tag={tag} aria-pressed="false">
            {tag}
          </button>
        ))}
      </div>
      <div class="tf-row" role="group" aria-labelledby="tag-filter-label">
        <span class="tf-row-label">Specialty:</span>
        {specialtyTagList.map((tag) => (
          <button type="button" class="tf-chip" data-tag={tag} aria-pressed="false">
            {tag}
          </button>
        ))}
        <button type="button" class="tf-clear" id="clearFilters" disabled>
          <i class="uil uil-times"></i> Clear filters
        </button>
      </div>
    </div>

    {
      projectGroups.map((group) => (
        <section data-cat={group.category}>
          <div class="section-head">
            <h2>{group.category}</h2>
            <span>{group.cards.length} Project(s)</span>
          </div>
          <div class="grid">
            {group.cards.map((card) => <ProjectCard {...card} />)}
          </div>
        </section>
      ))
    }

    <div class="no-results" id="noResults" hidden>
      <div class="nr-icon"><i class="uil uil-search"></i></div>
      <h3>No projects found</h3>
      <p>No projects match the current filters. Try removing some filters or switching categories.</p>
      <button type="button" class="nr-btn" id="noResultsClear">Clear filters</button>
    </div>
  </main>

  <ProjectModal />
</Layout>

<script>
  const select = document.getElementById('catFilter');
  const sections = document.querySelectorAll('[data-cat]');
  const chips = document.querySelectorAll('.tf-chip');
  const clearBtn = document.getElementById('clearFilters');
  const noResults = document.getElementById('noResults');
  const noResultsClear = document.getElementById('noResultsClear');

  function applyFilter() {
    const value = select?.value ?? 'all';
    const activeTags = Array.from(chips)
      .filter((chip) => chip.getAttribute('aria-pressed') === 'true')
      .map((chip) => chip.getAttribute('data-tag'));

    let totalVisible = 0;
    sections.forEach((section) => {
      const catMatch = value === 'all' || section.dataset.cat === value;
      let visible = 0;
      section.querySelectorAll('.card').forEach((card) => {
        const cardTags = (card.getAttribute('data-tags') ?? '').split('|');
        const show = catMatch && activeTags.every((tag) => cardTags.includes(tag));
        card.hidden = !show;
        if (show) visible++;
      });
      section.hidden = !catMatch || (activeTags.length > 0 && visible === 0);
      const badge = section.querySelector('.section-head span');
      if (badge) badge.textContent = `${visible} Project(s)`;
      totalVisible += visible;
    });

    if (noResults) noResults.hidden = totalVisible > 0;
    if (clearBtn) clearBtn.disabled = value === 'all' && activeTags.length === 0;
  }

  function clearFilters() {
    if (select) select.value = 'all';
    chips.forEach((chip) => chip.setAttribute('aria-pressed', 'false'));
    applyFilter();
  }

  if (select) select.addEventListener('change', applyFilter);
  if (clearBtn) clearBtn.addEventListener('click', clearFilters);
  if (noResultsClear) noResultsClear.addEventListener('click', clearFilters);
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      chip.setAttribute('aria-pressed', chip.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
      applyFilter();
    })
  );
</script>