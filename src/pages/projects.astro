---
import Layout from '../components/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectModal from '../components/ProjectModal.astro';
import { projectGroups } from '../data/projects';
---

<Layout
  title="Mateo Zamora — Projects"
  description="Comprehensive library of rigging and animation work by Mateo Zamora, organized for efficient exploration."
>
  <Navbar variant="projects" />

  <main class="wrap">
    <div class="header">
      <h1>Project Archives</h1>
      <p>A comprehensive library of my rigging and animation work, organized for efficient exploration.</p>
      <p class="hint">Press on any project's card to see more details.</p>
      <div class="filters">
        <label class="sel-wrap">
          <select class="sel" id="catFilter">
            <option value="all">Category — All</option>
            {projectGroups.map((group) => <option value={group.category}>{group.category}</option>)}
          </select>
          <i class="uil uil-angle-down"></i>
        </label>
      </div>
    </div>

    {
      projectGroups.map((group) => (
        <section data-cat={group.category}>
          <div class="section-head">
            <h2>{group.category}</h2>
            <span>{group.cards.length} Project(s)</span>
          </div>
          <div class="grid">
            {group.cards.map((card) => <ProjectCard {...card} />)}
          </div>
        </section>
      ))
    }
  </main>

  <ProjectModal />
</Layout>

<script>
  const select = document.getElementById('catFilter');
  const sections = document.querySelectorAll('[data-cat]');

  function applyFilter() {
    const value = select?.value ?? 'all';
    sections.forEach((section) => {
      section.hidden = !(value === 'all' || section.dataset.cat === value);
    });
  }

  if (select) select.addEventListener('change', applyFilter);
</script>